{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sir-ar-last-date",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Preview URLs would expose a second, uncached copy of the API.
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Workers Cache: answers repeated GETs from the edge without running the Worker.
  "cache": { "enabled": true },
  // Per-visitor brakes. Counters are per Cloudflare location and approximate.
  // Each `namespace_id` is a number we choose; it only has to be unique within
  // the Cloudflare account. Nothing is created in the dashboard.
  "ratelimits": [
    { "name": "RL_GRAPHQL", "namespace_id": "7301", "simple": { "limit": 40, "period": 60 } },
    { "name": "RL_REST", "namespace_id": "7302", "simple": { "limit": 240, "period": 60 } },
    // File lists for the similarity tab: one per repo, so a class of 120 goes through
    // in one minute. Above that the page waits for the limit and carries on by itself.
    { "name": "RL_TREE", "namespace_id": "7303", "simple": { "limit": 120, "period": 60 } }
  ],
  // Deploy fails if the token secret is missing.
  "secrets": { "required": ["GITHUB_TOKEN"] },
  "observability": { "enabled": true }
}
